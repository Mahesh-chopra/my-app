# ---------------------------------------------------------------------------
# Copy to .env and adjust. No secrets or credentials belong in source files.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
# Set to the frontend origin when hosted separately (e.g. https://your-site.pages.dev).
# Leave blank for same-origin serving; use * only for public, unauthenticated demos.
CORS_ORIGIN=

# Session behavior
ENABLE_DOCKER=false
SESSION_DURATION_MINUTES=15
MAX_UPLOAD_MB=100

# Docker / redroid (only used when ENABLE_DOCKER=true)
# Template commands are prepared even when Docker is disabled.
# On ARM64 hosts (e.g. Oracle Ampere A1), use an ARM64 tag such as:
# REDROID_IMAGE=redroid/redroid:15.0.0_64only-latest
REDROID_IMAGE=redroid/redroid:14.0.0-latest
WS_SCRCPY_IMAGE=remoteview/ws-scrcpy:latest
# Env var names expected by your ws-scrcpy image for the ADB target.
WS_SCRCPY_ADB_HOST_ENV=ADB_HOST
WS_SCRCPY_ADB_PORT_ENV=ADB_PORT
CONTAINER_PREFIX=caer
DOCKER_HOST=

# ADB and stream access (only used when ENABLE_DOCKER=true)
ADB_HOST=127.0.0.1
ADB_PORT_BASE=5555
STREAM_PORT_BASE=8000
PUBLIC_HOST=localhost
# Leave blank to derive from PUBLIC_HOST + STREAM_PORT_BASE.
STREAM_BASE_URL=
